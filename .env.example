# Neon Postgres connection string (used by the snapshot cron and as a last-good fallback).
DATABASE_URL=postgres://user:password@ep-example.eu-central-1.aws.neon.tech/countroom?sslmode=require

# Shared secret. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET=change-me

# Where IEC data comes from: "live" (the IEC feed, via our server) or "fixtures" (files in ./fixtures).
# Defaults to "fixtures" in development and tests, "live" in production.
# IEC_SOURCE=fixtures

# Seat model while a council is still counting: "droop" (PR-ballot Droop quota, the default) or "mmp"
# (the compensatory Municipal Structures Act Schedule 1 formula, experimental).
# SEAT_MODEL=droop

# Public URL of the site, used in share links and preview images. On Vercel this defaults to the
# production domain (VERCEL_PROJECT_PRODUCTION_URL); set it if you use a custom domain.
# NEXT_PUBLIC_SITE_URL=https://countroom.example

# Cloudflare Web Analytics site token (free, cookieless). Leave unset to disable analytics.
# Cloudflare dashboard > Analytics & Logs > Web Analytics > Add a site > copy the token from the snippet.
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# AI analyst panel (Claude API). PAID per request. Leave unset to keep the panel switched off.
# ANTHROPIC_API_KEY=
# Hard daily cap on AI answers across the whole site (default 300).
# AI_DAILY_LIMIT=300

# Show the Ask link in the navigation (set to 1 together with ANTHROPIC_API_KEY).
# NEXT_PUBLIC_AI_ENABLED=1
